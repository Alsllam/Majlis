{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/auth-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Auth": {
    "Issuer": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "Certificates": {}
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiter": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "RolePermissions": {
    "TenantOwner": [
      "*"
    ],
    "TenantAdmin": [
      "*"
    ],
    "Member": [
      "Permissions.Identity.ViewUsers"
    ]
  }
}
