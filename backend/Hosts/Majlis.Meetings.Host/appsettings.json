{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Wolverine": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/meetings-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Auth": {
    "Issuer": "",
    "Audience": "majlis-api"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "majlis",
    "Username": "",
    "Password": ""
  },
  "RateLimiter": {
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "BlobStorage": { "ConnectionString": "", "AccountUrl": "", "CorsAllowedOrigins": [] },
  "Meetings": { "MaxRecordingMb": 500, "UploadUrlMinutes": 30, "RecordingRetentionDays": 30 },
  "Approvals": { "BaseUrl": "http://localhost:7000/api/approvals" },
  "RolePermissions": {
    "TenantOwner": [ "*" ],
    "TenantAdmin": [ "*" ],
    "Member": [ "Permissions.Meetings.ViewMeeting", "Permissions.Meetings.ManageMeeting" ]
  }
}
