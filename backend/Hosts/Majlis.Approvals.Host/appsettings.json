{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Wolverine": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/approvals-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Auth": {
    "Issuer": "",
    "Audience": "majlis-api"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "majlis",
    "Username": "",
    "Password": ""
  },
  "RateLimiter": {
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "RolePermissions": {
    "TenantOwner": [
      "*"
    ],
    "TenantAdmin": [
      "*"
    ],
    "Member": [
      "Permissions.Approvals.ViewApproval",
      "Permissions.Approvals.RequestAction",
      "Permissions.Approvals.ApproveAction"
    ]
  },
  "Approvals": {
    "ExpiryHours": 24,
    "SweepIntervalSeconds": 60
  }
}
