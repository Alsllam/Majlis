{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "MassTransit": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/rooms-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 } }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Auth": { "Issuer": "", "Audience": "majlis-api" },
  "Cors": { "AllowedOrigins": [] },
  "RabbitMq": { "Host": "localhost", "VirtualHost": "majlis", "Username": "", "Password": "" },
  "RateLimiter": { "PermitLimit": 300, "WindowSeconds": 60, "SegmentsPerWindow": 6 },
  "AiService": { "BaseUrl": "http://localhost:8000", "TimeoutSeconds": 10 },
  "Rooms": { "DriverAbsenceTimeoutSeconds": 120, "SweepIntervalSeconds": 5, "TurnHeartbeatTimeoutSeconds": 30, "InitialEventCount": 200 },
  "RolePermissions": {
    "TenantOwner": [ "*" ],
    "TenantAdmin": [ "*" ],
    "Member": [ "Permissions.Rooms.ViewRoom", "Permissions.Rooms.CreateRoom", "Permissions.Rooms.DriveSession" ]
  }
}
