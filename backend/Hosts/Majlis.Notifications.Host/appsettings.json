{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Wolverine": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/notifications-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Auth": {
    "Issuer": "",
    "Audience": "majlis-api"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "majlis",
    "Username": "",
    "Password": ""
  },
  "RateLimiter": {
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "Notifications": { "WebBaseUrl": "http://localhost:4200", "IdentityUrl": "http://localhost:7001" },
  "Email": { "ConnectionString": "", "Sender": "DoNotReply@majlis.local" },
  "InternalAuth": { "TokenEndpoint": "", "ClientId": "majlis-notifications", "ClientSecret": "", "Scope": "majlis-internal" },
  "RolePermissions": {
    "TenantOwner": [ "*" ],
    "TenantAdmin": [ "*" ],
    "Member": [ "Permissions.Notifications.ViewNotification" ]
  }
}
