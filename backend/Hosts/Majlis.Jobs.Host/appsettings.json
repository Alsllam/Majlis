{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Hangfire": "Information", "Wolverine": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/jobs-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 } }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "RabbitMq": { "Host": "localhost", "Port": 5672, "VirtualHost": "majlis", "Username": "", "Password": "" },
  "Jobs": {
    "Schema": "jobs",
    "Dashboard": false,
    "Crons": {}
  }
}
