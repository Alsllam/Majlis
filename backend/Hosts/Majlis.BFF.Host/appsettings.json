{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-oidc": { "ClusterId": "auth", "Match": { "Path": "/connect/{**catch-all}" } },
      "auth-discovery": { "ClusterId": "auth", "Match": { "Path": "/.well-known/{**catch-all}" } },
      "auth-account": { "ClusterId": "auth", "Match": { "Path": "/Account/{**catch-all}" } },
      "auth-realtime-ticket": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/realtime/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "rooms": {
        "ClusterId": "rooms",
        "Match": { "Path": "/api/rooms/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/rooms" } ]
      },
      "hubs": { "ClusterId": "realtime", "Match": { "Path": "/hubs/{**catch-all}" } },
      "ai": { "ClusterId": "ai", "Match": { "Path": "/ai-api/{**catch-all}" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:7001/" } } },
      "rooms": { "Destinations": { "d1": { "Address": "http://localhost:7020/" } } },
      "realtime": {
        "SessionAffinity": { "Enabled": true, "Policy": "Cookie", "AffinityKeyName": "majlis.rt" },
        "Destinations": { "d1": { "Address": "http://localhost:7002/" } }
      },
      "ai": {
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "Destinations": { "d1": { "Address": "http://localhost:8000/" } }
      }
    }
  }
}
