# Local development only. Copy to ai-service/.env (git-ignored) or export these variables.
ENVIRONMENT=development
DEPLOYMENT_PROFILE=cloud

# Azure OpenAI (the key is for local development only; deployed environments use Entra ID)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

AUTH_ISSUER=http://localhost:7000/
AUTH_AUDIENCE=ai-api
REDIS_URL=redis://localhost:6379/0
# amqp://<user>:<password>@localhost:5672/majlis
RABBITMQ_URL=
