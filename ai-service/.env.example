# Local development only. Copy to ai-service/.env (git-ignored) or export these variables.
ENVIRONMENT=development
DEPLOYMENT_PROFILE=cloud

# Azure OpenAI (the key is for local development only; deployed environments use Entra ID)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Approvals module through the BFF (agent tools create approval requests there with the driver's token)
APPROVALS_URL=http://localhost:7000/api/approvals
MAX_TOOL_ROUNDS=5

AUTH_ISSUER=http://localhost:7000/
AUTH_AUDIENCE=ai-api
REDIS_URL=redis://localhost:6379/0
# amqp://<user>:<password>@localhost:5672/majlis
RABBITMQ_URL=

# Knowledge / RAG (ai-service). Locally: Azurite (compose) and the Redis-backed dev index; deployed: Azure Blob + Azure AI Search.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
SEARCH_BACKEND=local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_API_KEY=
