# Local development only. Copy to .env (git-ignored) and fill in every value.
# Never commit real values. Cloud environments read these from the secret store.

# SQL Server SA password (at least 8 chars with upper, lower, digit and symbol)
MSSQL_SA_PASSWORD=
RABBITMQ_USER=majlis
RABBITMQ_PASSWORD=

# Password for the seeded demo users (sara, khalid, noura @demo.majlis.local); at least 10 characters
MAJLIS_SEED_PASSWORD=
# Client secret the Realtime host uses to call Rooms (client credentials)
MAJLIS_REALTIME_CLIENT_SECRET=

# ai-service (next PR) — Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

